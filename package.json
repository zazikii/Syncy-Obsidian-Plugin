{
  "name": "syncy-obsidian-plugin",
  "version": "0.1.0",
  "description": "Self-hosted Obsidian sync client for the Syncy server",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "npm run build && node tests/e2e/obsidian.e2e.mjs",
    "test:watch": "vitest",
    "lint": "biome check src tests",
    "check": "npm run typecheck && npm run lint && npm test",
    "format": "biome check --write src tests"
  },
  "keywords": [
    "obsidian",
    "sync",
    "self-hosted"
  ],
  "author": "zazikii",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zazikii/Syncy-Obsidian-Plugin.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@electron/asar": "^4.3.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
